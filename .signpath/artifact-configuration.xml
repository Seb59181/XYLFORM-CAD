<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact à copier dans le projet SignPath « xylform-cad » (slug « initial »).
  L'artefact envoyé par le workflow release.yml est un zip contenant l'installateur NSIS et l'exe portable.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Xylform-CAD-Setup-*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Xylform-CAD-*-portable.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
